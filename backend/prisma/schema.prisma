generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FloodSnapshot {
  id String @id @default(uuid())
  recordedAt DateTime @default(now())
  imagePath String
  mediaType String @default("IMAGE")
  framesProcessed Int @default(1)
  latitude Float?
  longitude Float?
  annotatedImagePath String?
  floodMaskImagePath String?
  coveragePercentage Float
  severity String
  floodAreaSqKm Float
  spreadTrend String
  direction String
  detectionsJson String
}

model Settlement {
  id String @id
  name String
  population Int
  latitude Float
  longitude Float
  severity String
  evacuationPriority String
}

model RoadRoute {
  id String @id
  name String
  status String
  alternativeRoute String?
  geometryJson String?
}

model InfrastructureAsset {
  id String @id
  asset String
  type String
  status String
  confidence Float
  latitude Float
  longitude Float
}

model AssessmentReport {
  id String @id @default(uuid())
  eventId String @unique
  generatedAt DateTime @default(now())
  surveyArea String
  overallRisk String
  parametersJson String
  pdfPath String?
}

model ResponsePlan {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  priority String
  actionsJson String
  resourcesJson String
  snapshotId String
}
